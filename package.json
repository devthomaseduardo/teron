{
  "name": "teron",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @teron/web dev",
    "dev:api": "pnpm --filter @teron/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @teron/web build",
    "build:api": "pnpm --filter @teron/api build",
    "start:web": "pnpm --filter @teron/web start",
    "start:api": "pnpm --filter @teron/api start",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @teron/api seed",
    "init-db": "pnpm --filter @teron/api init-db",
    "test": "pnpm --filter @teron/api test",
    "test:db": "pnpm --filter @teron/api test:db"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
