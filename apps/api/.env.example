# ============================================================
# TERON API — copie para apps/api/.env (NAO commitar .env)
# ============================================================

# --- MongoDB Atlas (connection string, NAO a Admin API Key al-...) ---
# Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=teron

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=TERON <onboarding@resend.dev>

# --- Mercado Pago ---
# Access Token (APP_USR-... producao ou TEST-... sandbox)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Opcional (Checkout no browser / OAuth)
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_WEBHOOK_SECRET=

SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
