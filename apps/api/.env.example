# ============================================================
# TERON API - copie para apps/api/.env (NAO commitar .env)
# ============================================================

# Com docker compose (servico mongo):
# MONGODB_URI=mongodb://mongo:27017
#
# Com docker-compose.dev.yml ou Mongo local:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_CONNECTION_STRING=
MONGODB_DB=teron

# MongoDB Atlas:
# Use a connection string do painel Atlas > Database > Connect > Drivers.
# Nao use Admin API Key al-... como MONGODB_URI.

# Resend e Mercado Pago sao opcionais em dev, mas exigidos
# para envio real de proposta e checkout.
# Exemplos fake, nao reais:
# RESEND_API_KEY=NAO_REAL_re_example_api_key
# MERCADOPAGO_ACCESS_TOKEN=NAO_REAL_MP_ACCESS_TOKEN_EXAMPLE
# MERCADOPAGO_PUBLIC_KEY=NAO_REAL_MP_PUBLIC_KEY_EXAMPLE
# MERCADOPAGO_CLIENT_ID=NAO_REAL_example-client-id
# MERCADOPAGO_CLIENT_SECRET=NAO_REAL_example-client-secret
RESEND_API_KEY=
RESEND_FROM=TERON <onboarding@resend.dev>
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# URLs usadas por CORS e callbacks de pagamento.
SITE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
PORT=4000
NODE_ENV=development
