# =============================================================================
# TERON - variaveis de ambiente
# =============================================================================
# Template sem valores reais.
# Configure segredos somente em arquivos ignorados pelo Git ou na Vercel.
#
# Desenvolvimento local:
# - API: use apps/api/.env
# - Web: use apps/web/.env.local
#
# Na Vercel:
# - Configure em Settings > Environment Variables.
# - Nao use aspas no valor.
# - Nao deixe espaco no inicio ou fim.
# =============================================================================

# -----------------------------------------------------------------------------
# API - apps/api/.env
# -----------------------------------------------------------------------------

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_CONNECTION_STRING=
MONGODB_DB=teron

# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# E-mail via Resend:
RESEND_API_KEY=
RESEND_FROM=TERON <onboarding@resend.dev>

# Mercado Pago:
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# URLs usadas por CORS e callbacks:
SITE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Runtime da API:
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web - apps/web/.env.local
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
