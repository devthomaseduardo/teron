# =============================================================================
# TERON — Vercel / local
# =============================================================================
# Na Vercel: Settings > Environment Variables (Production + Preview)
# NAO commitar valores reais.
# =============================================================================

# Obrigatorio
MONGODB_URI=mongodb+srv://USER:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=teron

# E-mail (opcional — propostas sem Resend ficam salvas como rascunho)
RESEND_API_KEY=
RESEND_FROM=TERON <onboarding@resend.dev>

# URL publica do site (Vercel)
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
SITE_URL=https://seu-projeto.vercel.app

# Pagamentos desativados — nao precisa configurar Mercado Pago neste deploy
# MERCADOPAGO_ACCESS_TOKEN=
