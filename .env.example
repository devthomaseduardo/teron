# Variaveis usadas pelo docker compose.
# Copie para .env na raiz quando rodar `docker compose up --build`.
# Segredos reais: use .env local ou painel da Vercel. NUNCA commitar.

# API
MONGODB_URI=mongodb://mongo:27017
MONGODB_CONNECTION_STRING=
MONGODB_DB=teron
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Integracoes opcionais
# Exemplos fake, nao reais:
# RESEND_API_KEY=NAO_REAL_re_example_api_key
# MERCADOPAGO_ACCESS_TOKEN=NAO_REAL_MP_ACCESS_TOKEN_EXAMPLE
# MERCADOPAGO_PUBLIC_KEY=NAO_REAL_MP_PUBLIC_KEY_EXAMPLE
# MERCADOPAGO_CLIENT_ID=NAO_REAL_example-client-id
# MERCADOPAGO_CLIENT_SECRET=NAO_REAL_example-client-secret
RESEND_API_KEY=
RESEND_FROM=TERON <onboarding@resend.dev>
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
