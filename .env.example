# ============================================================
# TERON — variáveis de ambiente
# ============================================================
# 1. Copie este arquivo:
#    cp .env.example .env.local
# 2. Preencha os valores abaixo
# 3. Nunca commit .env.local
# ============================================================

# --- MongoDB (obrigatório) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Alternativa (mesmo efeito):
# MONGODB_CONNECTION_STRING=mongodb+srv://...
MONGODB_DB=teron

# --- Resend (e-mail de propostas e notificações) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=TERON <onboarding@resend.dev>
# Depois de verificar domínio no Resend, use por exemplo:
# RESEND_FROM=TERON <contato@teron.studio>

# --- Sessão / segurança ---
# Opcional. Se vazio, a app gera token aleatório por login.
# SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Ambiente ---
NODE_ENV=development

# --- Opcionais (próximas integrações) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
